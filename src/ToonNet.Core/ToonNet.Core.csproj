<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <!-- Package Information -->
        <PackageId>ToonNet.Core</PackageId>
        <Version>1.4.0</Version>
        <Title>ToonNet Core Library</Title>
        <Description>TOON (Token-Oriented Object Notation) serialization for .NET, implementing TOON spec v3.3.2 and tested against the official conformance fixtures. System.Text.Json-style ToonSerializer with cached metadata and compiled accessors, async and multi-document streaming, and a ToonDocument/ToonValue model. Useful for compact, LLM-friendly payloads, configuration files and data exchange.</Description>
        <PackageTags>toon;serialization;dotnet;ai;llm;token-efficient;streaming</PackageTags>
        <PackageReleaseNotes>v1.4.0: Streaming serialization API for millions of records. SerializeStreamAsync/DeserializeStreamAsync with O(1) memory, 2-3x faster throughput. ToonMultiDocumentWriteOptions (batch size, separator modes). Validation framework added. All 449 tests passing.</PackageReleaseNotes>
        
        <!-- Performance: Enable Profile-Guided Optimization -->
        <TieredCompilation>true</TieredCompilation>
        <TieredPGO>true</TieredPGO>
        <DynamicPGO>true</DynamicPGO>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="8.0.0" />
    </ItemGroup>

</Project>
