<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <!-- Package Information -->
        <PackageId>ToonNet.Core</PackageId>
        <Version>4.0.1</Version>
        <Title>ToonNet Core Library</Title>
        <Description>TOON (Token-Oriented Object Notation) serialization for .NET, implementing TOON spec v4.4 (all 564 official conformance fixtures pass; output identical to the official library). Fast System.Text.Json-style ToonSerializer with a source generator, cached metadata and compiled accessors, async and multi-document streaming, and a ToonDocument/ToonValue model. Useful for compact, LLM-friendly payloads, configuration files and data exchange.</Description>
        <PackageTags>toon;serialization;dotnet;ai;llm;token-efficient;streaming</PackageTags>
        <PackageReleaseNotes>See https://github.com/selcukgural/ToonNet/blob/master/CHANGELOG.md</PackageReleaseNotes>
        
        <!-- Trimming and NativeAOT: reflection-based APIs are annotated; generated code and the document model are safe -->
        <IsAotCompatible>true</IsAotCompatible>

        <!-- Performance: Enable Profile-Guided Optimization -->
        <TieredCompilation>true</TieredCompilation>
        <TieredPGO>true</TieredPGO>
        <DynamicPGO>true</DynamicPGO>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../Shared/ToonNaming.cs" Link="Shared/ToonNaming.cs" />
        <Compile Include="../Shared/ToonKeys.cs" Link="Shared/ToonKeys.cs" />
    </ItemGroup>

</Project>
